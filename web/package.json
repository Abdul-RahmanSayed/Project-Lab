{
  "name": "project-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "vite",
    "check:bundle": "node scripts/check-bundle.mjs",
    "types:api": "openapi-typescript src/generated/api-schema.json -o src/generated/api-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:bundle && npm run types:api && npm run typecheck && vite build",
    "build:deployment": "npm run build -- --mode deployment --outDir ../generated/deployment/site/Project-Lab",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:deployment": "playwright test --config playwright.deployment.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "d3": "7.9.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
